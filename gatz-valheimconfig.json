  {
    "DisplayName": "World Preset",
    "Category": "Valheim:stadia_controller",
    "Subcategory": "World Settings:public:3",
    "Description": "[Default]: The way Valheim is meant to be played, with intended difficulty balance. Highly recommended for your first playthrough for the best experience.\n\n[Easy] Combat easy, fewer base raids, [Hard]: Combat harder, base raids more often.\n\n[Hardcore]: Combat a lot harder, base raids more often, when you die all skills and items you are carrying will be lost forever, no map, no portal use, may not exit boss dungeons while boss is alive.\n\n[Casual]: Combat is a lot easier, enemies will not attack unless provoked, no base raids, resources are more plentiful, you will not drop items or lose skills on death.\n\n[Hammer Mode]: You can build all build pieces for free once you have discovered the recipe, no base raids, enemies will not attack unless provoked, other settings are normal.\n\n[Immersive]: No map, no portals, all other settings are normal. ",
    "Keywords": "preset,difficulty,world,settings",
    "FieldName": "worldPreset",
    "InputType": "enum",
    "IsFlagArgument": false,
    "ParamFieldName": "worldPreset",
    "IncludeInCommandLine": false,
    "DefaultValue": "",
    "EnumValues": {
      "": "Default",
      "-preset default ": "Default",
      "-preset easy ": "Easy",
      "-preset hard ": "Hard",
      "-preset hardcore ": "Hardcore",
      "-preset casual ": "Casual",
      "-preset hammer ": "Hammer",
      "-preset immersive ": "Immersive"
    }
  },
